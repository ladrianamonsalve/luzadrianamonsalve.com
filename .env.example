# Copy to .env.local and fill in. NEVER commit .env.local.

# Resend — email sending for /api/contact
# Get a key at https://resend.com (free 100/day).
# Without this key, the contact form logs payloads to the server console
# and still returns success (useful for local dev).
RESEND_API_KEY=

# Optional overrides. Defaults work for local dev.
CONTACT_TO_EMAIL=info@3dkmultiservices.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# HubSpot Service Key — every contact form submission also creates/updates
# a contact in HubSpot CRM. Generated from HubSpot dashboard →
# Development → Service Keys. Required scopes:
#   - crm.objects.contacts.read
#   - crm.objects.contacts.write
# If missing, the form still works (email goes out via Resend) but the
# CRM push is silently skipped.
HUBSPOT_API_KEY=
